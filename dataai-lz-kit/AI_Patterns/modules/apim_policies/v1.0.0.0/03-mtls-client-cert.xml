<policies>

  <inbound>
    <base />

    <choose>
      <when condition="@(!context.Request.Certificate.Verify() || context.Request.Certificate == null)">

        <return-response>
          <set-status 
              code="${mtls_failure_status_code}" 
              reason="${mtls_failure_reason}" />
        </return-response>

      </when>
    </choose>

  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>

</policies>