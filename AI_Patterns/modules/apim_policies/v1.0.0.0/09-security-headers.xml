<policies>

  <inbound>
    <base />
  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />

    <set-header name="Strict-Transport-Security" exists-action="${security_header_exists_action}">
      <value>${hsts_value}</value>
    </set-header>

    <set-header name="X-Content-Type-Options" exists-action="${security_header_exists_action}">
      <value>${x_content_type_options}</value>
    </set-header>

    <set-header name="X-Frame-Options" exists-action="${security_header_exists_action}">
      <value>${x_frame_options}</value>
    </set-header>

    <set-header name="Referrer-Policy" exists-action="${security_header_exists_action}">
      <value>${referrer_policy}</value>
    </set-header>

  </outbound>

  <on-error>
    <base />
  </on-error>

</policies>