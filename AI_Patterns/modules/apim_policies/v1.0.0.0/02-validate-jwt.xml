<policies>

  <inbound>
    <base />

    <validate-jwt
        header-name="${jwt_header_name}"
        failed-validation-httpcode="${jwt_failed_status_code}"
        failed-validation-error-message="${jwt_failed_message}"
        require-expiration-time="${jwt_require_expiry}"
        require-scheme="${jwt_scheme}">

        <openid-config url="${openid_config_url}" />

        <audiences>
            <audience>${jwt_audience}</audience>
        </audiences>

        <issuers>
            <issuer>${jwt_issuer}</issuer>
        </issuers>

    </validate-jwt>

  </inbound>

  <backend>
    <base />
  </backend>

  <outbound>
    <base />
  </outbound>

  <on-error>
    <base />
  </on-error>

</policies>