<policies>

  <inbound>
  <!-- JWT VALIDATION -->
      <validate-jwt
        header-name="${jwt_header_name}"
        failed-validation-httpcode="${jwt_failed_status_code}"
        failed-validation-error-message="${jwt_failed_message}"
        require-expiration-time="${jwt_require_expiry}"
        require-scheme="${jwt_scheme}">

        <openid-config url="${openid_config_url}" />

        <audiences>
            <audience>${jwt_audience}</audience>
        </audiences>

        <issuers>
            <issuer>${jwt_issuer}</issuer>
        </issuers>

      </validate-jwt>    
          
    <!-- RATE LIMIT -->
    <rate-limit-by-key
        calls="${rate_limit_calls}"
        renewal-period="${rate_limit_period}"
        counter-key="${rate_limit_counter_key}" />

     <!-- QUOTA -->
    <quota-by-key
        calls="${quota_calls}"
        renewal-period="${quota_period}"
        counter-key="${quota_counter_key}" />
        
      

    </inbound>

  <backend>
     </backend>

  <outbound>
   
  

  </outbound>

  <on-error>
   
    
  </on-error>

</policies>