{
  "displayName": "Azure Managed Redis: Enforce highAvailability=Enabled",
  "description": "Audits Microsoft.Cache/redisEnterprise/databases whose highAvailability is not Enabled. Audit-only in non-PROD; flip to Deny via assignment override in PROD. MCSB v2 RE-3.1, BR-1.1.",
  "mode": "All",
  "policyRule": {
    "if": {
      "allOf": [
        { "field": "type", "equals": "Microsoft.Cache/redisEnterprise/databases" },
        { "field": "Microsoft.Cache/redisEnterprise/databases/highAvailability", "notEquals": "Enabled" }
      ]
    },
    "then": { "effect": "[parameters('effect')]" }
  },
  "parameters": {
    "effect": { "type": "String", "metadata": { "displayName": "Effect" }, "allowedValues": ["Audit", "Deny", "Disabled"], "defaultValue": "Audit" }
  }
}
