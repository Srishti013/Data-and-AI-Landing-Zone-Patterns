{
  "displayName": "Azure Cosmos DB: Require TLS 1.2 or later",
  "description": "Denies Microsoft.DocumentDB/databaseAccounts whose minimalTlsVersion is not Tls12. MCSB v2 DP-3.1, NS-8.1.",
  "mode": "All",
  "policyRule": {
    "if": {
      "allOf": [
        { "field": "type", "equals": "Microsoft.DocumentDB/databaseAccounts" },
        { "field": "Microsoft.DocumentDB/databaseAccounts/minimalTlsVersion", "notEquals": "Tls12" }
      ]
    },
    "then": { "effect": "[parameters('effect')]" }
  },
  "parameters": {
    "effect": { "type": "String", "metadata": { "displayName": "Effect" }, "allowedValues": ["Audit", "Deny", "Disabled"], "defaultValue": "Deny" }
  }
}
