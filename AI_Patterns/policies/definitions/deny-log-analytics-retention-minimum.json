{
  "displayName": "Azure Log Analytics Workspace: Retain workspace data for at least 90 days",
  "description": "Denies Microsoft.OperationalInsights/workspaces whose retentionInDays is less than 90. MCSB v2 LT-6.1.",
  "mode": "All",
  "policyRule": {
    "if": {
      "allOf": [
        { "field": "type", "equals": "Microsoft.OperationalInsights/workspaces" },
        { "field": "Microsoft.OperationalInsights/workspaces/retentionInDays", "less": 90 }
      ]
    },
    "then": { "effect": "[parameters('effect')]" }
  },
  "parameters": {
    "effect": { "type": "String", "metadata": { "displayName": "Effect" }, "allowedValues": ["Audit", "Deny", "Disabled"], "defaultValue": "Deny" }
  }
}
